<%# locals: (error:) -%>
<% events = error.events.order(created_at: :desc, id: :desc) %>
<% if events.any? %>
  <section id="error-history" class="space-y-6">
    <h2 class="font-bold text-base">History</h2>
    <ol class="divide-y">
      <% events.each do |event| %>
        <li class="flex items-baseline justify-between gap-2 py-1">
          <span><%= event.description %></span>
          <abbr title="<%= event.created_at.iso8601 %>" class="cursor-help text-gray-500">
            <%= time_tag event.created_at, "#{time_ago_in_words(event.created_at)} ago" %>
          </abbr>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
