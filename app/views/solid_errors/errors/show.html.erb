<%= render "solid_errors/errors/error",
      error: @error,
      show_actions: true %>

<% if claiming? %>
  <br>
  <section id="error-claim" class="space-y-6">
    <% unless @error.resolved? %>
      <div class="flex flex-wrap items-center gap-3">
        <%= render "solid_errors/errors/claim", error: @error %>
      </div>
    <% end %>
    <%= render "solid_errors/errors/history", error: @error %>
  </section>
<% end %>

<br>
<br>

<%= render "solid_errors/occurrences/collection",
      occurrences: @occurrences,
      page: @page,
      titled: true %>
