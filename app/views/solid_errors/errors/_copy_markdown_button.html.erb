<%# locals: (error:) -%>
<% occurrences_count = error.occurrences.count %>
<div class="copy-markdown-split">
  <a href="<%= error_path(error, format: :md) %>"
     data-copy-markdown
     data-copy-markdown-main
     class="inline-flex items-center justify-center gap-2 font-medium cursor-pointer border rounded-lg py-3 px-5 bg-gray-100 text-initial border-gray-300 hover:ring-gray-200 hover:ring-8">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16">
      <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
      <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
    </svg>
    <span>Copy Markdown</span>
  </a>
  <% if occurrences_count > 1 %>
    <details class="copy-markdown-menu">
      <summary aria-label="Copy more occurrences"
               class="inline-flex items-center justify-center font-medium cursor-pointer border py-3 px-3 bg-gray-100 text-initial border-gray-300 hover:ring-gray-200 hover:ring-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/>
        </svg>
      </summary>
      <div class="copy-markdown-menu-items">
        <% [5, 10].select { |limit| limit < occurrences_count }.each do |limit| %>
          <a href="<%= error_path(error, format: :md, limit: limit) %>" data-copy-markdown>Last <%= limit %></a>
        <% end %>
        <% if occurrences_count <= SolidErrors::Error::MARKDOWN_OCCURRENCE_LIMIT %>
          <a href="<%= error_path(error, format: :md, limit: occurrences_count) %>" data-copy-markdown>All (<%= occurrences_count %>)</a>
        <% else %>
          <a href="<%= error_path(error, format: :md, limit: SolidErrors::Error::MARKDOWN_OCCURRENCE_LIMIT) %>" data-copy-markdown>Last <%= SolidErrors::Error::MARKDOWN_OCCURRENCE_LIMIT %></a>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
